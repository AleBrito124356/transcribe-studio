# transcribe-studio configuration
# Copy this file to .env and fill in the values you need.
# Transcription and subtitles work with NO key at all; only summaries,
# NIM chapters, and translation call the NVIDIA NIM API.

# --- NVIDIA NIM (free) -------------------------------------------------------
# Free API key for the OpenAI-compatible NIM endpoint. Sign up in ~2 minutes at
# https://build.nvidia.com — no credit card. The key starts with "nvapi-".
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Chat model used for summaries, chapters, and translation.
# Any NIM chat model works; the default is a strong, free 70B model.
NIM_MODEL=meta/llama-3.3-70b-instruct

# OpenAI-compatible base URL. Change only if you point at a self-hosted NIM
# or a different OpenAI-compatible gateway.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Optional: real speaker diarization -------------------------------------
# Only needed if you install pyannote.audio and call diarize_pyannote() (src/diarize.py).
# Create a token at https://huggingface.co/settings/tokens and accept the terms
# for pyannote/speaker-diarization-3.1.
# HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXX
