# transcribe-studio configuration
# Copy this file to .env and fill in the values you need.
# Transcription, subtitles, offline chapters and the offline extractive summary
# work with NO key at all; only NIM summaries, NIM chapters and translation call
# the NVIDIA NIM API. Settings here are read when a NIM client is created, so
# they apply even though the CLI loads this file after start-up.

# --- NVIDIA NIM (free) -------------------------------------------------------
# Free API key for the OpenAI-compatible NIM endpoint. Sign up in ~2 minutes at
# https://build.nvidia.com — no credit card. The key starts with "nvapi-".
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Chat model used for summaries, chapters, and translation.
# Any NIM chat model works; the default is a strong, free 70B model.
NIM_MODEL=meta/llama-3.3-70b-instruct

# OpenAI-compatible base URL. Change only if you point at a self-hosted NIM
# or a different OpenAI-compatible gateway.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Resilience for the rate-limited free tier. HTTP 429/5xx, timeouts and dropped
# connections are retried with exponential backoff (honouring Retry-After).
# A rejected key (401/403) or unknown model (404) is never retried.
NIM_MAX_RETRIES=3
# Seconds to wait for one response before treating it as a timeout.
NIM_TIMEOUT=120

# --- Optional: real speaker diarization -------------------------------------
# Only needed if you install pyannote.audio and call diarize_pyannote() (transcribe_studio/diarize.py).
# Create a token at https://huggingface.co/settings/tokens and accept the terms
# for pyannote/speaker-diarization-3.1.
# HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXX
