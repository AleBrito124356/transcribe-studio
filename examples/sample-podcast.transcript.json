as"},{"start":188.4,"end":188.82,"word":" flores."},{"start":189.2,"end":189.68,"word":" Tenemos"},{"start":189.74,"end":190.0,"word":" que"},{"start":190.06,"end":190.54,"word":" comprar"},{"start":190.6,"end":190.86,"word":" más"},{"start":190.92,"end":191.29,"word":" abono"},{"start":191.35,"end":191.67,"word":" esta"},{"start":191.73,"end":192.15,"word":" semana."}]},{"start":193.76,"end":196.98,"text":"Lo anoto. ¿Algún consejo contra las plagas?","words":[{"start":193.76,"end":193.98,"word":" Lo"},{"start":194.04,"end":194.41,"word":" anoto."},{"start":194.79,"end":195.16,"word":" ¿Algún"},{"start":195.22,"end":195.69,"word":" consejo"},{"start":195.75,"end":196.17,"word":" contra"},{"start":196.23,"end":196.5,"word":" las"},{"start":196.56,"end":196.98,"word":" plagas?"}]},{"start":198.59,"end":204.53,"text":"Revisa el envés de las hojas cada semana y retira a mano las hojas con manchas.","words":[{"start":198.59,"end":199.01,"word":" Revisa"},{"start":199.07,"end":199.29,"word":" el"},{"start":199.35,"end":199.72,"word":" envés"},{"start":199.78,"end":199.99,"word":" de"},{"start":200.05,"end":200.32,"word":" las"},{"start":200.38,"end":200.75,"word":" hojas"},{"start":200.81,"end":201.13,"word":" cada"},{"start":201.19,"end":201.61,"word":" semana"},{"start":201.67,"end":201.83,"word":" y"},{"start":201.89,"end":202.31,"word":" retira"},{"start":202.37,"end":202.53,"word":" a"},{"start":202.59,"end":202.91,"word":" mano"},{"start":202.97,"end":203.24,"word":" las"},{"start":203.3,"end":203.67,"word":" hojas"},{"start":203.73,"end":203.99,"word":" con"},{"start":204.05,"end":204.53,"word":" manchas."}]},{"start":205.04,"end":212.72,"text":"Y no te olvides de poner tutores a cada planta, porque con el viento del balcón los tallos se doblan.","words":[{"start":205.04,"end":205.2,"word":" Y"},{"start":205.26,"end":205.47,"word":" no"},{"start":205.53,"end":205.75,"word":" te"},{"start":205.81,"end":206.28,"word":" olvides"},{"start":206.34,"end":206.56,"word":" 