149.99,"end":150.67,"word":" recomiendas?"}]},{"start":152.28,"end":158.86,"text":"Por lo menos veinte litros por planta, con buen drenaje y un sustrato suelto con compost.","words":[{"start":152.28,"end":152.54,"word":" Por"},{"start":152.6,"end":152.82,"word":" lo"},{"start":152.88,"end":153.25,"word":" menos"},{"start":153.31,"end":153.73,"word":" veinte"},{"start":153.79,"end":154.21,"word":" litros"},{"start":154.27,"end":154.54,"word":" por"},{"start":154.6,"end":155.02,"word":" planta,"},{"start":155.26,"end":155.53,"word":" con"},{"start":155.59,"end":155.9,"word":" buen"},{"start":155.96,"end":156.44,"word":" drenaje"},{"start":156.5,"end":156.66,"word":" y"},{"start":156.72,"end":156.93,"word":" un"},{"start":156.99,"end":157.52,"word":" sustrato"},{"start":157.58,"end":158.0,"word":" suelto"},{"start":158.06,"end":158.33,"word":" con"},{"start":158.39,"end":158.86,"word":" compost."}]},{"start":160.47,"end":165.06,"text":"¿Y el riego? En verano el balcón se convierte en un horno.","words":[{"start":160.47,"end":160.63,"word":" ¿Y"},{"start":160.69,"end":160.91,"word":" el"},{"start":160.97,"end":161.34,"word":" riego?"},{"start":161.72,"end":161.93,"word":" En"},{"start":161.99,"end":162.41,"word":" verano"},{"start":162.47,"end":162.69,"word":" el"},{"start":162.75,"end":163.17,"word":" balcón"},{"start":163.23,"end":163.44,"word":" se"},{"start":163.5,"end":164.08,"word":" convierte"},{"start":164.14,"end":164.36,"word":" en"},{"start":164.42,"end":164.63,"word":" un"},{"start":164.69,"end":165.06,"word":" horno."}]},{"start":166.67,"end":173.88,"text":"Instalé un riego por goteo con un temporizador barato. Cada planta recibe agua dos veces al día.","words":[{"start":166.67,"end":167.14,"word":" Instalé"},{"start":167.2,"end":167.42,"word":" un"},{"start":167.48,"end":167.85,"word":" riego"},{"start":167.91,"end":168.17,"word":" por"},{"start":168.23,"end":168.6,"word":" goteo"},{"start":168.66,"end":168.93,"word":" con"},{"start":168.99,"end":169.2,"wo