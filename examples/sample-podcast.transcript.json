{"language":"en","duration":219.76,"model_size":"sample: hand-written text, synthetic word timings","segments":[{"start":0.6,"end":7.56,"text":"Welcome back to Build Notes, the show where we fix small problems before they become big ones.","words":[{"start":0.6,"end":1.07,"word":" Welcome"},{"start":1.13,"end":1.45,"word":" back"},{"start":1.51,"end":1.73,"word":" to"},{"start":1.79,"end":2.16,"word":" Build"},{"start":2.22,"end":2.59,"word":" Notes,"},{"start":2.83,"end":3.09,"word":" the"},{"start":3.15,"end":3.47,"word":" show"},{"start":3.53,"end":3.9,"word":" where"},{"start":3.96,"end":4.17,"word":" we"},{"start":4.23,"end":4.5,"word":" fix"},{"start":4.56,"end":4.93,"word":" small"},{"start":4.99,"end":5.52,"word":" problems"},{"start":5.58,"end":6.0,"word":" before"},{"start":6.06,"end":6.38,"word":" they"},{"start":6.44,"end":6.86,"word":" become"},{"start":6.92,"end":7.18,"word":" big"},{"start":7.24,"end":7.56,"word":" ones."}]},{"start":8.07,"end":13.41,"text":"Today my co-host Marta and I are talking about backups for a home server.","words":[{"start":8.07,"end":8.44,"word":" Today"},{"start":8.5,"end":8.72,"word":" my"},{"start":8.78,"end":9.2,"word":" co-host"},{"start":9.26,"end":9.63,"word":" Marta"},{"start":9.69,"end":9.95,"word":" and"},{"start":10.01,"end":10.18,"word":" I"},{"start":10.24,"end":10.5,"word":" are"},{"start":10.56,"end":11.04,"word":" talking"},{"start":11.1,"end":11.47,"word":" about"},{"start":11.53,"end":12.0,"word":" backups"},{"start":12.06,"end":12.33,"word":" for"},{"start":12.39,"end":12.55,"word":" a"},{"start":12.61,"end":12.93,"word":" home"},{"start":12.99,"end":13.41,"word":" server."}]},{"start":15.02,"end":23.32,"text":"Thanks, Leo. I want to start with a confession: for two years my backups were broken and I had no idea.","words":[{"start":15.02,"end":15.44,"word":" Thanks,"},{"start":15.68,"end":15.95,"word":" Leo."},{"start":16.33,"end":16.49,"word":" I"},{"start":16.55,"end":16.87,"word":" want"},{"start":16.93,"end":17.14,"word":" to"},{"start":17.2,"end":17.57,"word":" start"},{"start":17.63,"end":17.95,"word":" with"},{"start":18.01,"end":18.17,"word":" a"},{"start":18.23,"end":18.86,"word":" confession:"},{"start":19.1,"end":19.37,"word":" for"},{"start":19.43,"end":19.69,"word":" two"},{"start":19.75,"end":20.12,"word":" years"},{"start":20.18,"end":20.4,"word":" my"},{"start":20.46,"end":20.93,"word":" backups"},{"start":20.99,"end":21.31,"word":" were"},{"start":21.37,"end":21.79,"word":" broken"},{"start":21.85,"end":22.12,"word":" and"},{"start":22.18,"end":22.34,"word":" I"},{"start":22.4,"end":22.66,"word":" had"},{"start":22.72,"end":22.94,"word":" no"},{"start":23.0,"end":23.32,"word":" idea."}]},{"start":23.83,"end":30.38,"text":"The backup job ran every night, the log said success, and nobody ever tried a restore.","words":[{"start":23.83,"end":24.09,"word":" The"},{"start":24.15,"end":24.57,"word":" backup"},{"start":24.63,"end":24.9,"word":" job"},{"start":24.96,"end":25.23,"word":" ran"},{"start":25.29,"end":25.66,"word":" every"},{"start":25.72,"end":26.09,"word":" night,"},{"start":26.33,"end":26.59,"word":" the"},{"start":26.65,"end":26.92,"word":" log"},{"start":26.98,"end":27.3,"word":" said"},{"start":27.36,"end":27.83,"word":" success,"},{"start":28.07,"end":28.34,"word":" and"},{"start":28.4,"end":28.82,"word":" nobody"},{"start":28.88,"end":29.2,"word":" ever"},{"start":29.26,"end":29.63,"word":" tried"},{"start":29.69,"end":29.85,"word":" a"},{"start":29.91,"end":30.38,"word":" restore."}]},{"start":31.99,"end":38.18,"text":"That is the classic failure. A backup only counts once you have restored from it.","words":[{"start":31.99,"end":32.31,"word":" That"},{"start":32.37,"end":32.58,"word":" is"},{"start":32.64,"end":32.91,"word":" the"},{"start":32.97,"end":33.44,"word":" classic"},{"start":33.5,"end":33.98,"word":" failure."},{"start":34.36,"end":34.52,"word":" A"},{"start":34.58,"end":35.0,"word":" backup"},{"start":35.06,"end":35.38,"word":" only"},{"start":35.44,"end":35.86,"word":" counts"},{"start":35.92,"end":36.24,"word":" once"},{"start":36.3,"end":36.57,"word":" you"},{"start":36.63,"end":36.94,"word":" have"},{"start":37.0,"end":37.53,"word":" restored"},{"start":37.59,"end":37.91,"word":" from"},{"start":37.97,"end":38.18,"word":" it."}]},{"start":38.69,"end":43.29,"text":"So what does a sane setup look like for a small home server?","words":[{"start":38.69,"end":38.91,"word":" So"},{"start":38.97,"end":39.28,"word":" what"},{"start":39.34,"end":39.66,"word":" does"},{"start":39.72,"end":39.88,"word":" a"},{"start":39.94,"end":40.26,"word":" sane"},{"start":40.32,"end":40.69,"word":" setup"},{"start":40.75,"end":41.07,"word":" look"},{"start":41.13,"end":41.45,"word":" like"},{"start":41.51,"end":41.77,"word":" for"},{"start":41.83,"end":42.0,"word":" a"},{"start":42.06,"end":42.43,"word":" small"},{"start":42.49,"end":42.8,"word":" home"},{"start":42.86,"end":43.29,"word":" server?"}]},{"start":44.9,"end":53.21,"text":"I follow the three two one rule: three copies of the data, on two kinds of storage, with one copy offsite.","words":[{"start":44.9,"end":45.06,"word":" I"},{"start":45.12,"end":45.54,"word":" follow"},{"start":45.6,"end":45.87,"word":" the"},{"start":45.93,"end":46.3,"word":" three"},{"start":46.36,"end":46.62,"word":" two"},{"start":46.68,"end":46.95,"word":" one"},{"start":47.01,"end":47.33,"word":" rule:"},{"start":47.57,"end":47.94,"word":" three"},{"start":48.0,"end":48.42,"word":" copies"},{"start":48.48,"end":48.69,"word":" of"},{"start":48.75,"end":49.02,"word":" the"},{"start":49.08,"end":49.4,"word":" data,"},{"start":49.64,"end":49.85,"word":" on"},{"start":49.91,"end":50.18,"word":" two"},{"start":50.24,"end":50.61,"word":" kinds"},{"start":50.67,"end":50.88,"word":" of"},{"start":50.94,"end":51.41,"word":" storage,"},{"start":51.65,"end":51.97,"word":" with"},{"start":52.03,"end":52.3,"word":" one"},{"start":52.36,"end":52.68,"word":" copy"},{"start":52.74,"end":53.21,"word":" offsite."}]},{"start":53.72,"end":59.84,"text":"On the server I take restic snapshots every night, and they go to a second disk.","words":[{"start":53.72,"end":53.93,"word":" On"},{"start":53.99,"end":54.26,"word":" the"},{"start":54.32,"end":54.74,"word":" server"},{"start":54.8,"end":54.96,"word":" I"},{"start":55.02,"end":55.34,"word":" take"},{"start":55.4,"end":55.82,"word":" restic"},{"start":55.88,"end":56.46,"word":" snapshots"},{"start":56.52,"end":56.89,"word":" every"},{"start":56.95,"end":57.32,"word":" night,"},{"start":57.56,"end":57.83,"word":" and"},{"start":57.89,"end":58.21,"word":" they"},{"start":58.27,"end":58.48,"word":" go"},{"start":58.54,"end":58.75,"word":" to"},{"start":58.81,"end":58.98,"word":" a"},{"start":59.04,"end":59.46,"word":" second"},{"start":59.52,"end":59.84,"word":" disk."}]},{"start":61.45,"end":62.95,"text":"And the offsite copy?","words":[{"start":61.45,"end":61.71,"word":" And"},{"start":61.77,"end":62.04,"word":" the"},{"start":62.1,"end":62.57,"word":" offsite"},{"start":62.63,"end":62.95,"word":" copy?"}]},{"start":64.56,"end":72.99,"text":"An encrypted restic repository in cheap object storage. The encryption matters, because the provider holds the files.","words":[{"start":64.56,"end":64.77,"word":" An"},{"start":64.83,"end":65.41,"word":" encrypted"},{"start":65.47,"end":65.89,"word":" restic"},{"start":65.95,"end":66.58,"word":" repository"},{"start":66.64,"end":66.86,"word":" in"},{"start":66.92,"end":67.29,"word":" cheap"},{"start":67.35,"end":67.77,"word":" object"},{"start":67.83,"end":68.3,"word":" storage."},{"start":68.68,"end":68.95,"word":" The"},{"start":69.01,"end":69.64,"word":" encryption"},{"start":69.7,"end":70.17,"word":" matters,"},{"start":70.41,"end":70.89,"word":" because"},{"start":70.95,"end":71.21,"word":" the"},{"start":71.27,"end":71.8,"word":" provider"},{"start":71.86,"end":72.23,"word":" holds"},{"start":72.29,"end":72.56,"word":" the"},{"start":72.62,"end":72.99,"word":" files."}]},{"start":74.6,"end":77.18,"text":"How long do you keep the snapshots?","words":[{"start":74.6,"end":74.86,"word":" How"},{"start":74.92,"end":75.24,"word":" long"},{"start":75.3,"end":75.51,"word":" do"},{"start":75.57,"end":75.84,"word":" you"},{"start":75.9,"end":76.22,"word":" keep"},{"start":76.28,"end":76.54,"word":" the"},{"start":76.6,"end":77.18,"word":" snapshots?"}]},{"start":78.79,"end":86.31,"text":"Seven daily snapshots, four weekly and twelve monthly. That retention policy keeps the repository small.","words":[{"start":78.79,"end":79.16,"word":" Seven"},{"start":79.22,"end":79.59,"word":" daily"},{"start":79.65,"end":80.23,"word":" snapshots,"},{"start":80.47,"end":80.79,"word":" four"},{"start":80.85,"end":81.27,"word":" weekly"},{"start":81.33,"end":81.6,"word":" and"},{"start":81.66,"end":82.08,"word":" twelve"},{"start":82.14,"end":82.61,"word":" monthly."},{"start":82.99,"end":83.31,"word":" That"},{"start":83.37,"end":83.95,"word":" retention"},{"start":84.01,"end":84.43,"word":" policy"},{"start":84.49,"end":84.86,"word":" keeps"},{"start":84.92,"end":85.19,"word":" the"},{"start":85.25,"end":85.88,"word":" repository"},{"start":85.94,"end":86.31,"word":" small."}]},{"start":87.92,"end":90.23,"text":"So what changed after the scare?","words":[{"start":87.92,"end":88.13,"word":" So"},{"start":88.19,"end":88.51,"word":" what"},{"start":88.57,"end":89.04,"word":" changed"},{"start":89.1,"end":89.47,"word":" after"},{"start":89.53,"end":89.8,"word":" the"},{"start":89.86,"end":90.23,"word":" scare?"}]},{"start":91.84,"end":100.78,"text":"We need to test a restore from the offsite copy every month, a full restore to a spare disk, not just listing files.","words":[{"start":91.84,"end":92.05,"word":" We"},{"start":92.11,"end":92.43,"word":" need"},{"start":92.49,"end":92.7,"word":" to"},{"start":92.76,"end":93.08,"word":" test"},{"start":93.14,"end":93.3,"word":" a"},{"start":93.36,"end":93.84,"word":" restore"},{"start":93.9,"end":94.22,"word":" from"},{"start":94.28,"end":94.54,"word":" the"},{"start":94.6,"end":95.08,"word":" offsite"},{"start":95.14,"end":95.45,"word":" copy"},{"start":95.51,"end":95.88,"word":" every"},{"start":95.94,"end":96.31,"word":" month,"},{"start":96.55,"end":96.72,"word":" a"},{"start":96.78,"end":97.09,"word":" full"},{"start":97.15,"end":97.63,"word":" restore"},{"start":97.69,"end":97.9,"word":" to"},{"start":97.96,"end":98.12,"word":" a"},{"start":98.18,"end":98.55,"word":" spare"},{"start":98.61,"end":98.93,"word":" disk,"},{"start":99.17,"end":99.44,"word":" not"},{"start":99.5,"end":99.82,"word":" just"},{"start":99.88,"end":100.35,"word":" listing"},{"start":100.41,"end":100.78,"word":" files."}]},{"start":102.39,"end":106.41,"text":"Let's schedule the first restore test for Saturday morning.","words":[{"start":102.39,"end":102.71,"word":" Let's"},{"start":102.77,"end":103.29,"word":" schedule"},{"start":103.35,"end":103.62,"word":" the"},{"start":103.68,"end":104.05,"word":" first"},{"start":104.11,"end":104.58,"word":" restore"},{"start":104.64,"end":104.96,"word":" test"},{"start":105.02,"end":105.29,"word":" for"},{"start":105.35,"end":105.87,"word":" Saturday"},{"start":105.93,"end":106.41,"word":" morning."}]},{"start":108.02,"end":113.99,"text":"Deal. I'll write the retention policy and the restore steps in the wiki tonight.","words":[{"start":108.02,"end":108.34,"word":" Deal."},{"start":108.72,"end":108.98,"word":" I'll"},{"start":109.04,"end":109.41,"word":" write"},{"start":109.47,"end":109.74,"word":" the"},{"start":109.8,"end":110.38,"word":" retention"},{"start":110.44,"end":110.86,"word":" policy"},{"start":110.92,"end":111.18,"word":" and"},{"start":111.24,"end":111.51,"word":" the"},{"start":111.57,"end":112.04,"word":" restore"},{"start":112.1,"end":112.47,"word":" steps"},{"start":112.53,"end":112.75,"word":" in"},{"start":112.81,"end":113.07,"word":" the"},{"start":113.13,"end":113.45,"word":" wiki"},{"start":113.51,"end":113.99,"word":" tonigh